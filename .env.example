# Copie para .env (que o git ignora) e troque o valor antes do docker compose up.
# Gerar um segredo: openssl rand -base64 48
# No Windows, confira que o valor não ficou com \r no fim.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# Primeiro admin (opcional). Registre a conta pelo /api/auth/register, ponha o email aqui
# e reinicie a API: o usuário vira ADMIN na subida. Nenhuma conta ou senha é criada daqui.
ADMIN_EMAIL=
